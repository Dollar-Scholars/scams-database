# Copy this file to .env (same folder as manage.py) and edit it:
#     PowerShell:  Copy-Item .env.example .env
#     bash/macOS:  cp .env.example .env
# .env is git-ignored. Never commit real secrets or passwords.
# Variables already set in your shell take priority over this file.

# ---------------------------------------------------------------------------
# Django
# ---------------------------------------------------------------------------

# True for local development only. Defaults to False when unset.
DJANGO_DEBUG=True

# Required when DJANGO_DEBUG is False. Generate one with:
#     python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# Left empty with DJANGO_DEBUG=True, an insecure dev-only key is used.
DJANGO_SECRET_KEY=

# Comma-separated host names this site answers to (no scheme, no port).
# Empty with DJANGO_DEBUG=True -> localhost,127.0.0.1,[::1]
DJANGO_ALLOWED_HOSTS=

# Comma-separated full origins allowed to POST forms when served behind a
# proxy or on a custom domain, e.g. https://scams.example.org
DJANGO_CSRF_TRUSTED_ORIGINS=

# Where `python manage.py collectstatic` puts files (default: ./staticfiles).
# DJANGO_STATIC_ROOT=

# Only used when DJANGO_DEBUG is False. Both default to True (cookies sent over
# HTTPS only); set to False only on a plain-HTTP test server.
# DJANGO_SESSION_COOKIE_SECURE=True
# DJANGO_CSRF_COOKIE_SECURE=True

# Only used when DJANGO_DEBUG is False. True when a reverse proxy (nginx, Caddy)
# terminates HTTPS and always overwrites X-Forwarded-Proto (never passes on the
# client's value). Default False.
# DJANGO_SECURE_PROXY_SSL_HEADER=False

# Only used when DJANGO_DEBUG is False, and only once the site works over HTTPS.
# Redirect every http:// request to https:// (default False).
# Behind a reverse proxy that terminates HTTPS, first set
# DJANGO_SECURE_PROXY_SSL_HEADER=True and DJANGO_CSRF_TRUSTED_ORIGINS (above),
# or every page redirects to itself forever and forms fail with 403 (CSRF).
# DJANGO_SECURE_SSL_REDIRECT=True
# Seconds browsers must keep using HTTPS (HSTS). 0 = off (default). Start small
# (3600) and raise it (31536000 = 1 year) once HTTPS is known to work.
# DJANGO_SECURE_HSTS_SECONDS=3600

# ---------------------------------------------------------------------------
# Database: SQLite (default)
# ---------------------------------------------------------------------------

# Used when POSTGRES_HOST is not set. Default: db.sqlite3 next to manage.py.
# SQLITE_PATH=

# ---------------------------------------------------------------------------
# Database: PostgreSQL (optional)
# ---------------------------------------------------------------------------
# Uncomment POSTGRES_HOST (and fill in the rest) to switch from SQLite to
# PostgreSQL. Setup guide: docs/POSTGRES.md

# POSTGRES_HOST=192.168.1.50
# POSTGRES_PORT=5432
# POSTGRES_DB=scams
# POSTGRES_USER=scams_app
# Easiest: a password with no quotes, spaces or # in it, e.g. one made with
#     python -c "import secrets; print(secrets.token_hex(24))"
# Otherwise wrap it in single quotes and write a ' inside it as \' and a \ as \\
#     POSTGRES_PASSWORD='it\'s a#b'
# POSTGRES_PASSWORD=change-me
# disable | allow | prefer (default) | require | verify-ca | verify-full
# POSTGRES_SSLMODE=require
# Seconds to wait for the server before giving up (default 10).
# POSTGRES_CONNECT_TIMEOUT=10
# Seconds to reuse a connection between requests; 0 = new connection per request (default 60).
# POSTGRES_CONN_MAX_AGE=60

# ---------------------------------------------------------------------------
# Backups: python manage.py backup_db
# ---------------------------------------------------------------------------

# Folder for backup files (default: ./backups).
# BACKUP_DIR=
# Delete this command's backups older than N days; 0 keeps everything (default 14).
# BACKUP_KEEP_DAYS=14
# Comma-separated scp destinations the new backup is copied to (needs SSH keys).
# BACKUP_REMOTE_TARGETS=backup@192.168.1.60:/srv/backups/scams/
# Full path to pg_dump if it is not on PATH. Must be the same or a newer major
# version than the PostgreSQL server. Use forward slashes and no double quotes.
# PG_DUMP=C:/Program Files/PostgreSQL/16/bin/pg_dump.exe
